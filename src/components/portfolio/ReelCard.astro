---
interface Props {
  reel: {
    title: string;
    subtitle: string;
    package: string;
    length: string;
    video?: string;
    preview?: string;
    poster?: string;
    offsetY: number;
    gradientFrom: string;
    gradientTo: string;
    hero?: boolean;
    badge?: string;
  };
  index: number;
  openLabel?: string;
}

const { reel, index, openLabel = 'open rate card' } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article
  data-card
  data-y={reel.offsetY}
  data-title={reel.title}
  data-pkg={reel.package}
  data-len={reel.length}
  data-hero={reel.hero ? '' : undefined}
  data-full={reel.video || undefined}
  class={reel.hero ? 'reel-card reel-card--hero' : 'reel-card'}
  role="button"
  tabindex="0"
  aria-label={`${reel.title} — ${openLabel}`}
>
  <div
    style={`position:relative;width:100%;aspect-ratio:9/16;border-radius:5px;background:linear-gradient(160deg,${reel.gradientFrom},${reel.gradientTo});display:flex;align-items:center;justify-content:center`}
  >
    <video
      data-vid
      muted
      loop
      playsinline
      preload="metadata"
      poster={reel.poster || undefined}
      src={reel.preview || reel.video || undefined}
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:5px;display:none"
    ></video>
    <span data-vidph style="font:500 11px/1.4 'Quicksand',sans-serif;color:rgba(74,51,64,.55)">[ reel 9:16 ]</span>
    <span
      style={`position:absolute;top:9px;left:9px;padding:3px 9px;border-radius:99px;font:500 11px/1 'Quicksand',sans-serif;${reel.hero ? 'background:var(--rose);color:#fffaf9' : 'background:#fffaf9'}`}
    >{num}</span>
    <span style="position:absolute;bottom:9px;right:9px;padding:3px 8px;border-radius:99px;background:rgba(255,250,249,.9);font:500 10px/1 'Quicksand',sans-serif">{reel.length}</span>
  </div>
  <div style="position:absolute;left:15px;right:15px;bottom:12px">
    <div style="font:600 22px/1 'Caveat',cursive">{reel.title}</div>
    <div style="font:500 10.5px/1 'Quicksand',sans-serif;color:rgba(74,51,64,.5);margin-top:4px">{reel.subtitle}</div>
  </div>
  {reel.badge && (
    <div style="position:absolute;top:-16px;right:-14px;padding:7px 12px;border-radius:99px;background:var(--mint);font:600 17px/1 'Caveat',cursive;transform:rotate(8deg);animation:sway 5s ease-in-out infinite">{reel.badge}</div>
  )}
</article>
