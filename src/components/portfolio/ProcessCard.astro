---
interface Props {
  step: {
    title: string;
    body: string;
    kicker: string;
    background: string;
    badge: string;
    dir: number;
  };
  index: number;
}

const { step, index } = Astro.props;
const kickerColor = step.background === '#fffaf9' ? 'var(--rose)' : '#fffaf9';
const bodyColor = step.background === '#fffaf9' ? 'rgba(74,51,64,.75)' : 'rgba(74,51,64,.8)';
const shadow = step.background === '#fffaf9'
  ? '0 20px 40px -24px rgba(74,51,64,.45)'
  : '0 20px 40px -24px rgba(74,51,64,.5)';
---

<div
  data-panel
  data-dir={step.dir}
  style={`position:relative;padding:30px;border-radius:20px;background:${step.background};box-shadow:${shadow};opacity:0`}
>
  <div style={`position:absolute;top:-16px;left:-10px;width:50px;height:50px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:${step.badge};font:700 24px/1 'Caveat',cursive`}>{index + 1}</div>
  <div style="font:italic 400 25px/1.15 'DM Serif Display',serif;margin-top:16px">{step.title}</div>
  <p style={`margin:12px 0 0;font:500 14px/1.65 'Quicksand',sans-serif;color:${bodyColor}`}>{step.body}</p>
  <div style={`margin-top:14px;font:600 22px/1 'Caveat',cursive;color:${kickerColor}`}>{step.kicker}</div>
</div>
