---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ReelCard from '../components/portfolio/ReelCard.astro';
import RateCard from '../components/portfolio/RateCard.astro';
import ProcessCard from '../components/portfolio/ProcessCard.astro';

import profile from '../data/profile.json';
import reelsData from '../data/reels.json';
import ratesData from '../data/rates.json';
import processData from '../data/process.json';
import contact from '../data/contact.json';

const { reels, terms } = reelsData;
const firstName = [...profile.name];
const lastName = [...profile.surname];
const skillColor: Record<string, string> = {
  blush: 'var(--blush)',
  mint: 'var(--mint)',
  lilac: 'var(--lilac)',
  butter: 'var(--butter)'
};
const clients = processData.clients ?? [];
const marquee = clients.length ? clients.join(' ♡ ') + ' ♡ ' : '';
---

<PortfolioLayout title={`${profile.name} ${profile.surname} | ${profile.tagline}`} description={profile.bio}>
  <div class="paper-grid"></div>

  <header style="position:fixed;top:0;left:0;right:0;z-index:40;display:flex;justify-content:space-between;align-items:center;gap:10px;padding:16px 26px">
    <span style="padding:6px 14px;border-radius:99px;background:var(--blush);font:600 17px/1.1 'Caveat',cursive;transform:rotate(-1.5deg)">núria’s little journal</span>
    <span style="display:flex;align-items:center;gap:8px;transform:rotate(1.5deg)">
      <a href={profile.tiktok} target="_blank" rel="noopener" style="padding:6px 13px;border-radius:99px;background:#fffaf9;border:1.5px solid var(--blush);font:500 12px/1 'Quicksand',sans-serif;color:var(--ink)">TikTok {profile.tiktokHandle}</a>
      <a href={profile.instagram} target="_blank" rel="noopener" style="padding:6px 13px;border-radius:99px;background:#fffaf9;border:1.5px solid var(--lilac);font:500 12px/1 'Quicksand',sans-serif;color:var(--ink)">IG {profile.instagramHandle}</a>
    </span>
  </header>

  <div style="position:relative;width:100%">

    <!-- ===== 1 + 2: intro writes itself in, then the reel filmstrip ===== -->
    <section data-sec="a" style="position:relative;height:400vh">
      <div style="position:sticky;top:0;height:100vh;overflow:hidden;z-index:1">

        <div data-intro style="position:absolute;inset:0;will-change:transform,opacity">
          <div data-openhint style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center">
            <div style="font:600 34px/1.2 'Caveat',cursive;color:rgba(74,51,64,.5)">scroll to open the page…</div>
            <div style="margin-top:8px;font:500 12px/1 'Quicksand',sans-serif;letter-spacing:.14em;color:rgba(74,51,64,.4);animation:blink 2.2s ease-in-out infinite">♡ ♡ ♡</div>
          </div>

          <div data-photo class="intro-photo" style="position:absolute;right:8vw;top:14vh;transform:translateY(-40px) rotate(-8deg);opacity:0">
            <div class="polaroid" style="position:relative;width:clamp(190px,20vw,268px);padding:13px 13px 54px;background:#fffaf9;border-radius:6px;box-shadow:0 18px 34px -18px rgba(74,51,64,.4)">
              <div style="width:100%;aspect-ratio:4/5;border-radius:4px;overflow:hidden;background:linear-gradient(140deg,var(--blush),var(--lilac))">
                <img src={profile.profileImage} alt={`${profile.name} ${profile.surname}`} loading="eager" style="width:100%;height:100%;object-fit:cover;display:block" />
              </div>
              <div class="polaroid-caption" style="position:absolute;left:16px;bottom:15px;font:600 23px/1 'Caveat',cursive;color:var(--rose)">{profile.photoCaption}</div>
            </div>
            <div style="position:absolute;top:-13px;left:32px;width:94px;height:26px;background:rgba(248,223,160,.85);transform:rotate(-7deg);border-left:2px dotted rgba(74,51,64,.2);border-right:2px dotted rgba(74,51,64,.2)"></div>
          </div>

          <div class="intro-text" style="position:absolute;left:7vw;top:50%;transform:translateY(-50%);max-width:62vw">
            <div data-line style="font:600 30px/1 'Caveat',cursive;color:var(--rose);opacity:0">{profile.greeting}</div>
            <h1 style="margin:0">
              <span style="display:flex;flex-wrap:wrap;margin-top:4px">
                {firstName.map((ch) => (
                  <span data-l style="display:inline-block;font:700 clamp(66px,11.5vw,172px)/0.92 'Caveat',cursive;opacity:0">{ch}</span>
                ))}
              </span>
              <span style="display:flex;flex-wrap:wrap;margin-top:-.12em">
                {lastName.map((ch) => (
                  <span data-l style="display:inline-block;font:italic 400 clamp(44px,7.4vw,112px)/1 'DM Serif Display',serif;color:var(--rose);opacity:0">{ch}</span>
                ))}
              </span>
            </h1>
            <div data-line style="margin-top:20px;max-width:34ch;font:500 15px/1.7 'Quicksand',sans-serif;color:rgba(74,51,64,.75);opacity:0">{profile.bio}</div>
            <div data-line style="display:flex;flex-wrap:wrap;gap:9px;margin-top:22px;opacity:0">
              {profile.skills.map((s) => (
                <span style={`padding:8px 14px;border-radius:99px;background:${skillColor[s.color] ?? 'var(--blush)'};font:500 12px/1 'Quicksand',sans-serif`}>{s.label}</span>
              ))}
            </div>
          </div>

          <div data-sticker class="intro-sticker" style="position:absolute;right:17vw;bottom:15vh;width:clamp(128px,14vw,180px);aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--butter);box-shadow:0 14px 30px -16px rgba(74,51,64,.5);transform:scale(0) rotate(-14deg);opacity:0">
            <span style="font:600 clamp(21px,2.4vw,30px)/1.1 'Caveat',cursive;text-align:center;transform:rotate(-8deg);white-space:pre-line">{profile.stickerText}</span>
          </div>
        </div>

        <div data-track style="position:absolute;top:50%;left:0;display:flex;align-items:center;gap:40px;padding:0 8vw;will-change:transform">
          {reels.map((reel, i) => <ReelCard reel={reel} index={i} />)}
        </div>

        <div data-stripmeta class="strip-meta" style="position:absolute;left:8vw;bottom:66px;opacity:0;transition:opacity .4s ease">
          <div style="font:italic 400 32px/1 'DM Serif Display',serif">the reels</div>
          <div style="font:600 23px/1.2 'Caveat',cursive;color:var(--rose)">tap one for the rate card →</div>
        </div>
      </div>
    </section>

    <!-- ===== 3: how it goes ===== -->
    <section style="position:relative;z-index:2;padding:96px 0 116px;background:#fbe9ee">
      {marquee && (
        <div style="overflow:hidden;padding:8px 0;border-top:1.5px dotted rgba(74,51,64,.28);border-bottom:1.5px dotted rgba(74,51,64,.28)">
          <div style="display:flex;width:200%;animation:tick 30s linear infinite;white-space:nowrap;gap:44px;font:italic 400 clamp(32px,4.6vw,66px)/1 'DM Serif Display',serif;color:rgba(74,51,64,.34)">
            <span>{marquee}</span>
            <span>{marquee}</span>
          </div>
        </div>
      )}

      <div style="padding:0 6vw;margin-top:60px">
        <div style="display:inline-block;padding:8px 20px;border-radius:99px;background:#fffaf9;transform:rotate(-1.4deg);font:italic 400 clamp(28px,3.6vw,52px)/1.1 'DM Serif Display',serif">{processData.heading}</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;margin-top:46px">
          {processData.steps.map((step, i) => <ProcessCard step={step} index={i} />)}
        </div>
      </div>
    </section>

    <!-- ===== 4: rates ===== -->
    <section data-sec="c" id="rates" style="position:relative;z-index:2;padding:110px 6vw 130px">
      <div data-glow style="position:absolute;left:50%;top:0;width:min(820px,90vw);height:460px;transform:translate(-50%,0);pointer-events:none;background:radial-gradient(50% 50% at 50% 50%,rgba(248,204,215,.75),transparent 70%)"></div>
      <div style="position:relative;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:14px">
        <div style="display:inline-block;padding:8px 20px;border-radius:99px;background:var(--butter);transform:rotate(1.2deg);font:italic 400 clamp(28px,3.6vw,52px)/1.1 'DM Serif Display',serif">the rates</div>
        <span style="font:500 12px/1.6 'Quicksand',sans-serif;color:rgba(74,51,64,.55)">{ratesData.note}</span>
      </div>

      <div style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:54px">
        {ratesData.tiers.map((tier) => <RateCard tier={tier} />)}
      </div>
    </section>

    <!-- ===== 5: closer ===== -->
    <section id="contact" style="position:relative;z-index:2;padding:110px 6vw 170px;background:var(--ink);color:#fdf4f2;border-radius:38px 38px 0 0">
      <div style="max-width:900px">
        <div style="font:600 30px/1 'Caveat',cursive;color:var(--blush)">{contact.kicker}</div>
        <div style="margin-top:12px;font:italic 400 clamp(36px,5.6vw,88px)/1.05 'DM Serif Display',serif">{contact.headline}</div>
        <div style="margin-top:10px;font:700 clamp(34px,4.4vw,62px)/1 'Caveat',cursive;color:var(--butter)">{contact.subhead}</div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:44px;margin-top:66px;max-width:1000px">
        <div style="display:flex;flex-direction:column;gap:26px">
          <div>
            <div style="font:600 25px/1 'Caveat',cursive;color:var(--blush)">{contact.packageLabel}</div>
            <div data-pillgroup="package" style="display:flex;flex-wrap:wrap;gap:9px;margin-top:12px">
              {contact.packages.map((p) => <button type="button" data-pill class="pill" aria-pressed="false">{p}</button>)}
            </div>
          </div>
          <div>
            <div style="font:600 25px/1 'Caveat',cursive;color:var(--blush)">{contact.timelineLabel}</div>
            <div data-pillgroup="timeline" style="display:flex;flex-wrap:wrap;gap:9px;margin-top:12px">
              {contact.timelines.map((t) => <button type="button" data-pill class="pill" aria-pressed="false">{t}</button>)}
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <p style="margin:0;max-width:32ch;font:600 24px/1.35 'Caveat',cursive;opacity:.85">{contact.dmLine}</p>
            <a href={`mailto:${profile.email}`} style="align-self:flex-start;padding:10px 16px;border-radius:99px;background:rgba(253,244,242,.12);color:var(--butter);font:500 13px/1 'Quicksand',sans-serif">{profile.email}</a>
            <div style="display:flex;flex-wrap:wrap;gap:9px;margin-top:10px">
              <a href={profile.tiktok} target="_blank" rel="noopener" style="display:flex;align-items:center;gap:8px;padding:11px 17px;border-radius:99px;background:var(--blush);color:var(--ink);font:500 13px/1 'Quicksand',sans-serif">TikTok · {profile.tiktokHandle} <span style="font:500 11px/1 'Quicksand',sans-serif;opacity:.65">most active</span></a>
              <a href={profile.instagram} target="_blank" rel="noopener" style="padding:11px 17px;border-radius:99px;border:1.5px solid rgba(253,244,242,.35);color:#fdf4f2;font:500 13px/1 'Quicksand',sans-serif">Instagram · {profile.instagramHandle}</a>
            </div>
          </div>
        </div>

        <form data-form style="display:flex;flex-direction:column;gap:22px">
          <label style="display:block;position:relative">
            <span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">your name</span>
            <input data-field name="name" placeholder="your name" class="field" />
            <span data-underline style="position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--butter);transition:width .45s cubic-bezier(.16,1,.3,1)"></span>
          </label>
          <label style="display:block;position:relative">
            <span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">email</span>
            <input data-field name="email" type="email" placeholder="email" class="field" />
            <span data-underline style="position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--butter);transition:width .45s cubic-bezier(.16,1,.3,1)"></span>
          </label>
          <label style="display:block;position:relative">
            <span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">product / brand</span>
            <input data-field name="brand" placeholder="product / brand" class="field" />
            <span data-underline style="position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--butter);transition:width .45s cubic-bezier(.16,1,.3,1)"></span>
          </label>
          <button type="submit" class="send-btn">send it →</button>
        </form>
      </div>
      <div style="height:60px"></div>
    </section>
  </div>

  <div style="position:fixed;left:0;right:0;bottom:0;z-index:45;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:11px 22px;background:#fffaf9;border-top:1.5px solid var(--blush)">
    <span style="display:flex;align-items:center;gap:9px;font:600 20px/1 'Caveat',cursive"><span style="width:8px;height:8px;border-radius:99px;background:var(--rose);animation:blink 2.4s ease-in-out infinite"></span><span data-availability>{profile.availability}</span></span>
    <span style="display:flex;align-items:center;gap:12px;font:500 12px/1 'Quicksand',sans-serif"><span data-traycount style="color:rgba(74,51,64,.55)">proposal tray — 0</span><a href="#contact" data-trayreview style="font:600 19px/1 'Caveat',cursive">review →</a></span>
  </div>

  <div data-overlay role="dialog" aria-modal="true" aria-label="Rate card" style="position:fixed;inset:0;z-index:60;display:none;opacity:0;transition:opacity .35s ease;background:rgba(74,51,64,.55);backdrop-filter:blur(8px)">
    <div class="ov-grid" style="position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:4vw;padding:6vh 5vw 90px">
      <div data-ov-video class="ov-video" style="justify-self:end;position:relative;width:min(300px,100%,calc((100vh - 210px) * 0.5625));padding:13px 13px 44px;background:#fffaf9;border-radius:10px;box-shadow:0 40px 80px -34px rgba(74,51,64,.75);transform:rotate(-2deg) scale(.9);transition:transform .45s cubic-bezier(.2,1.3,.4,1)">
        <div style="position:relative;width:100%;aspect-ratio:9/16;border-radius:6px;background:linear-gradient(160deg,var(--butter),var(--blush));display:flex;align-items:center;justify-content:center">
          <video data-ov-vid loop playsinline controls preload="metadata" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:6px;display:none"></video>
          <span data-ov-ph style="font:500 11px/1.5 'Quicksand',sans-serif;color:rgba(74,51,64,.6);text-align:center">[ reel plays<br />with sound ]</span>
          <div data-ov-scrub style="position:absolute;left:9px;right:9px;bottom:9px;display:flex;align-items:center;gap:9px;padding:7px 11px;border-radius:99px;background:rgba(255,250,249,.92)">
            <span style="font:500 11px/1 'Quicksand',sans-serif">▶</span>
            <span style="flex:1;height:4px;border-radius:4px;background:rgba(74,51,64,.18)"><span style="display:block;width:38%;height:4px;border-radius:4px;background:var(--rose)"></span></span>
            <span data-ov-len style="font:500 10px/1 'Quicksand',sans-serif">0:26</span>
          </div>
        </div>
        <div style="position:absolute;left:15px;bottom:11px;font:600 20px/1 'Caveat',cursive;color:var(--rose)">sound on ♪</div>
      </div>

      <div data-ov-card class="ov-card" style="justify-self:start;width:min(420px,100%);padding:30px;border-radius:24px;background:#fffaf9;box-shadow:0 44px 84px -36px rgba(74,51,64,.8);transform:translateX(46px) rotate(1deg);opacity:0;transition:transform .45s cubic-bezier(.2,1.25,.4,1),opacity .35s ease">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px">
          <div>
            <div style="display:inline-block;padding:5px 13px;border-radius:99px;background:var(--blush);font:600 18px/1 'Caveat',cursive;transform:rotate(-1.5deg)">rate card</div>
            <div data-ov-title style="font:italic 400 25px/1.15 'DM Serif Display',serif;margin-top:12px">{reels[2].title}</div>
          </div>
          <button type="button" data-ov-close class="ov-close" aria-label="Close rate card">×</button>
        </div>
        <div style="border-top:1.5px dotted rgba(74,51,64,.25);margin:22px 0"></div>
        <div style="display:flex;flex-direction:column;gap:13px;font:500 13px/1.4 'Quicksand',sans-serif">
          <div style="display:flex;justify-content:space-between;gap:12px"><span style="color:rgba(74,51,64,.55)">package</span><span data-ov-pkg>{reels[2].package}</span></div>
          {terms.map((t) => (
            <div style="display:flex;justify-content:space-between;gap:12px"><span style="color:rgba(74,51,64,.55)">{t.label}</span><span>{t.value}</span></div>
          ))}
        </div>
        <div style="border-top:1.5px dotted rgba(74,51,64,.25);margin:22px 0"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:14px">
          <div>
            <div style="font:600 19px/1 'Caveat',cursive;color:rgba(74,51,64,.6)">estimate</div>
            <div data-ov-price style="font:italic 400 38px/1 'DM Serif Display',serif;margin-top:6px">{reels[2].price}</div>
          </div>
          <button type="button" data-ov-add class="ov-add">add to proposal</button>
        </div>
      </div>
    </div>
  </div>
</PortfolioLayout>

<script>
  const q = <T extends Element>(s: string) => document.querySelector(s) as T | null;
  const qa = <T extends Element>(s: string) => [...document.querySelectorAll(s)] as T[];

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mi = reduced ? 0 : 1;

  const el = {
    secA: q<HTMLElement>('[data-sec="a"]'),
    intro: q<HTMLElement>('[data-intro]'),
    hint: q<HTMLElement>('[data-openhint]'),
    photo: q<HTMLElement>('[data-photo]'),
    sticker: q<HTMLElement>('[data-sticker]'),
    letters: qa<HTMLElement>('[data-l]'),
    lines: qa<HTMLElement>('[data-line]'),
    track: q<HTMLElement>('[data-track]'),
    cards: qa<HTMLElement>('[data-card]'),
    meta: q<HTMLElement>('[data-stripmeta]'),
    panels: qa<HTMLElement>('[data-panel]'),
    glow: q<HTMLElement>('[data-glow]'),
    secC: q<HTMLElement>('[data-sec="c"]'),
    ov: q<HTMLElement>('[data-overlay]'),
    ovCard: q<HTMLElement>('[data-ov-card]'),
    ovVideo: q<HTMLElement>('[data-ov-video]')
  };

  /* ---------- proposal tray ---------- */
  const tray = new Set<string>();
  let lastFocused: HTMLElement | null = null;

  function addToTray(label: string) {
    tray.add(label.trim());
    const t = q<HTMLElement>('[data-traycount]');
    if (t) {
      t.textContent = 'proposal tray — ' + tray.size;
      t.style.color = 'var(--rose)';
    }
  }

  /* ---------- inline reel videos ---------- */
  function syncVideos() {
    qa<HTMLVideoElement>('[data-vid]').forEach((v) => {
      const ph = v.parentElement?.querySelector<HTMLElement>('[data-vidph]');
      if (v.getAttribute('src')) {
        v.style.display = 'block';
        if (ph) ph.style.display = 'none';
        v.play().catch(() => {});
      } else {
        v.style.display = 'none';
        if (ph) ph.style.display = '';
      }
    });
  }

  /* ---------- rate-card overlay ---------- */
  function openCard(card: HTMLElement, i: number) {
    const ov = el.ov;
    if (!ov) return;
    lastFocused = card;

    const set = (sel: string, val?: string) => {
      const n = q<HTMLElement>(sel);
      if (n && val) n.textContent = val;
    };
    set('[data-ov-title]', card.dataset.title);
    set('[data-ov-price]', card.dataset.price);
    set('[data-ov-len]', card.dataset.len);
    set('[data-ov-pkg]', card.dataset.pkg);

    const ovv = q<HTMLVideoElement>('[data-ov-vid]');
    const ovph = q<HTMLElement>('[data-ov-ph]');
    const scrub = q<HTMLElement>('[data-ov-scrub]');
    const src = el.cards[i]?.querySelector<HTMLVideoElement>('[data-vid]')?.getAttribute('src') || '';
    if (ovv) {
      if (src) {
        if (ovv.src !== src) ovv.src = src;
        ovv.style.display = 'block';
        if (ovph) ovph.style.display = 'none';
        if (scrub) scrub.style.display = 'none';
        ovv.muted = false;
        ovv.currentTime = 0;
        ovv.play().catch(() => {
          ovv.muted = true;
          ovv.play().catch(() => {});
        });
      } else {
        ovv.style.display = 'none';
        if (ovph) ovph.style.display = '';
        if (scrub) scrub.style.display = '';
      }
    }

    ov.style.display = 'block';
    requestAnimationFrame(() => {
      ov.style.opacity = '1';
      if (el.ovVideo) el.ovVideo.style.transform = 'rotate(-2deg) scale(1)';
      if (el.ovCard) {
        el.ovCard.style.opacity = '1';
        el.ovCard.style.transform = 'translateX(0) rotate(1deg)';
      }
      q<HTMLElement>('[data-ov-close]')?.focus();
    });
  }

  function closeCard() {
    const ov = el.ov;
    if (!ov || ov.style.display !== 'block') return;
    ov.style.opacity = '0';
    q<HTMLVideoElement>('[data-ov-vid]')?.pause();
    if (el.ovVideo) el.ovVideo.style.transform = 'rotate(-2deg) scale(.9)';
    if (el.ovCard) {
      el.ovCard.style.opacity = '0';
      el.ovCard.style.transform = 'translateX(46px) rotate(1deg)';
    }
    setTimeout(() => {
      ov.style.display = 'none';
    }, 340);
    lastFocused?.focus();
    lastFocused = null;
  }

  /* ---------- wiring ---------- */
  el.cards.forEach((c, i) => {
    c.addEventListener('click', () => openCard(c, i));
    c.addEventListener('keydown', (ev) => {
      const e = ev as KeyboardEvent;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openCard(c, i);
      }
    });
  });

  q<HTMLElement>('[data-ov-close]')?.addEventListener('click', closeCard);
  el.ov?.addEventListener('click', (e) => {
    if (e.target === el.ov || (e.target as HTMLElement).parentElement === el.ov) closeCard();
  });
  q<HTMLElement>('[data-ov-add]')?.addEventListener('click', () => {
    addToTray(q<HTMLElement>('[data-ov-title]')?.textContent || '');
    closeCard();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCard();
  });

  qa<HTMLButtonElement>('[data-pick]').forEach((b) => {
    b.addEventListener('click', () => {
      const tier = b.closest<HTMLElement>('[data-tier]');
      addToTray(tier?.dataset.tierName || '');
      b.textContent = 'added ✓';
      setTimeout(() => {
        b.textContent = 'add to proposal';
      }, 1600);
    });
  });

  qa<HTMLElement>('[data-pillgroup]').forEach((g) => {
    const pills = qa<HTMLButtonElement>('[data-pill]').filter((p) => g.contains(p));
    pills.forEach((p) => {
      p.addEventListener('click', () => {
        const on = p.getAttribute('aria-pressed') === 'true';
        pills.forEach((o) => o.setAttribute('aria-pressed', 'false'));
        p.setAttribute('aria-pressed', on ? 'false' : 'true');
      });
    });
  });

  qa<HTMLInputElement>('[data-field]').forEach((f) => {
    const u = f.parentElement?.querySelector<HTMLElement>('[data-underline]');
    f.addEventListener('focus', () => {
      if (u) u.style.width = '100%';
    });
    f.addEventListener('blur', () => {
      if (u && !f.value) u.style.width = '0';
    });
  });

  /* ---------- contact form -> mailto ---------- *
     No backend on this project, so the enquiry is composed as an email with
     everything the visitor picked already filled in. */
  const EMAIL = q<HTMLAnchorElement>('a[href^="mailto:"]')?.href.replace('mailto:', '') || '';

  function selectedIn(group: string) {
    const g = q<HTMLElement>(`[data-pillgroup="${group}"]`);
    return g?.querySelector<HTMLElement>('[data-pill][aria-pressed="true"]')?.textContent?.trim() || '';
  }

  q<HTMLFormElement>('[data-form]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = (n: string) => q<HTMLInputElement>(`[data-field][name="${n}"]`)?.value.trim() || '';
    const pkg = selectedIn('package');
    const when = selectedIn('timeline');
    const lines = [
      val('name') && `Name: ${val('name')}`,
      val('email') && `Email: ${val('email')}`,
      val('brand') && `Product / brand: ${val('brand')}`,
      pkg && `Package: ${pkg}`,
      when && `Timeline: ${when}`,
      tray.size && `Proposal tray: ${[...tray].join(', ')}`
    ].filter(Boolean);
    const subject = `Collab enquiry${val('brand') ? ' — ' + val('brand') : ''}`;
    window.location.href =
      `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n') + '\n\n')}`;
  });

  q<HTMLAnchorElement>('[data-trayreview]')?.addEventListener('click', () => {
    q<HTMLElement>('#contact')?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
  });

  /* ---------- scroll loop ---------- */
  const cl = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const back = (t: number) => 1 + 2.2 * Math.pow(t - 1, 3) + 1.7 * Math.pow(t - 1, 2);

  let smooth = window.scrollY;

  function loop() {
    smooth += (window.scrollY - smooth) * 0.11;
    const y = smooth;
    const vh = window.innerHeight;
    const vw = window.innerWidth;

    if (el.secA && el.intro && el.track && el.meta && el.cards.length) try {
      const top = el.secA.offsetTop;
      const span = el.secA.offsetHeight - vh;
      const p = cl((y - top) / span, 0, 1);
      const pw = cl(p / 0.2, 0, 1); // the name writes itself in
      const pOut = cl((p - 0.3) / 0.16, 0, 1); // the page turns away
      const p3r = cl((p - 0.44) / 0.56, 0, 1); // filmstrip pan, finishes at p=1
      const p3 = p3r < 0.5 ? 2 * p3r * p3r : 1 - Math.pow(-2 * p3r + 2, 2) / 2;

      if (el.hint) el.hint.style.opacity = String(cl(1 - pw * 4, 0, 1));

      const n = el.letters.length;
      el.letters.forEach((L, i) => {
        const t = reduced ? cl(pw / 0.3, 0, 1) : cl((pw - (i / n) * 0.72) / 0.28, 0, 1);
        L.style.opacity = String(t);
        L.style.transform = reduced
          ? 'none'
          : `translateY(${(1 - back(t)) * 34}px) rotate(${(1 - t) * (i % 2 ? 7 : -7)}deg) scale(${0.7 + back(t) * 0.3})`;
      });
      el.lines.forEach((L, i) => {
        const t = cl((pw - 0.4 - i * 0.14) / 0.3, 0, 1);
        L.style.opacity = String(t);
        L.style.transform = `translateY(${(1 - t) * 16 * mi}px)`;
      });
      if (el.photo) {
        const t = cl((pw - 0.22) / 0.4, 0, 1);
        el.photo.style.opacity = String(t);
        el.photo.style.transform = reduced
          ? 'rotate(-8deg)'
          : `translateY(${(1 - back(t)) * 90}px) rotate(${-8 + (1 - t) * 14}deg)`;
      }
      if (el.sticker) {
        const t = cl((pw - 0.62) / 0.38, 0, 1);
        el.sticker.style.opacity = String(t);
        el.sticker.style.transform = reduced ? 'rotate(-6deg)' : `scale(${back(t)}) rotate(${-14 + t * 8}deg)`;
      }

      el.intro.style.opacity = String(1 - ease(pOut));
      el.intro.style.filter = `blur(${pOut * 10 * mi}px)`;
      el.intro.style.transform = `translateY(${ease(pOut) * vh * 0.4 * mi}px) scale(${1 - pOut * 0.05 * mi})`;
      el.intro.style.pointerEvents = pOut > 0.4 ? 'none' : 'auto';

      const cw = el.cards[0].offsetWidth;
      const ch = el.cards[0].offsetHeight;
      const park = vh / 2 + ch / 2 + 60;
      const rise = 1 - ease(pOut);
      el.cards.forEach((c) => {
        const base = Number(c.dataset.y);
        c.style.opacity = String(cl((pOut - 0.1) * 2.2, 0, 1));
        c.style.transform = `translateY(${base * ease(pOut) + rise * park}px) scale(${0.9 + ease(pOut) * 0.1})`;
      });

      const pad = vw * 0.08;
      const gap = 40;
      const idx = 2;
      const x0 = vw / 2 - (pad + idx * (cw + gap) + cw / 2);
      const total = pad * 2 + el.cards.length * cw + (el.cards.length - 1) * gap;
      const endX = Math.min(x0, vw - total);
      el.track.style.transform = `translateY(-50%) translateX(${x0 + p3 * (endX - x0)}px)`;
      el.meta.style.opacity = String(cl((pOut - 0.2) * 2, 0, 1) * (1 - cl((p3 - 0.86) / 0.14, 0, 1)));
      el.track.style.opacity = String(1 - cl((p - 0.985) / 0.015, 0, 1));
    } catch {
      /* one bad frame (mid-resize, zero-size card) must not kill the loop */
    }

    el.panels.forEach((m) => {
      const r = m.getBoundingClientRect();
      const t = ease(cl((vh * 0.9 - r.top) / (vh * 0.42), 0, 1));
      m.style.opacity = String(t);
      const dir = Number(m.dataset.dir);
      m.style.transform = `translateX(${dir * (1 - t) * 200 * mi}px) translateY(${(1 - t) * 20 * mi}px) rotate(${dir * (1 - t) * 4 * mi}deg)`;
    });

    if (el.secC && el.glow) {
      const r = el.secC.getBoundingClientRect();
      const t = cl((vh - r.top) / (vh + r.height), 0, 1);
      el.glow.style.transform = `translate(-50%,${t * (r.height - 300)}px)`;
      el.glow.style.opacity = String(0.4 + 0.6 * Math.sin(t * Math.PI));
    }

    requestAnimationFrame(loop);
  }

  syncVideos();
  requestAnimationFrame(loop);
</script>
