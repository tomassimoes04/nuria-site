---
import '../styles/portfolio.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  alternate?: string;
  alternateLang?: string;
}

const {
  title = "Núria Chaves | UGC & Short-Form Video Creator",
  description = "UGC and short-form video for brands. Reels, packages and past work — hooks first, always.",
  lang = 'en',
  alternate,
  alternateLang
} = Astro.props;

const site = Astro.site?.origin ?? 'https://nuria-site.vercel.app';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf4f2" />
    <meta name="google-site-verification" content="Z2BaXuchYFpDeM0BRIEh6F_v0-ahheTXuv5njM4v6pg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/og-image.jpg" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=DM+Serif+Display:ital@0;1&family=Quicksand:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {alternate && alternateLang && (
      <>
        <link rel="alternate" hreflang={alternateLang} href={`${site}${alternate}`} />
        <link rel="alternate" hreflang={lang} href={`${site}${Astro.url.pathname}`} />
        <link rel="canonical" href={`${site}${Astro.url.pathname}`} />
      </>
    )}

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
